<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="170dp" android:padding="4dp">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_glass_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_artwork" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="12dp"
                android:src="@drawable/widget_music_note" android:scaleType="centerCrop" android:contentDescription="@null" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_music_title" android:textSize="20sp" android:textColor="#DDE5F4" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_music_access_off" android:textSize="12sp" android:textColor="#DDE5F4" android:layout_marginTop="5dp"
                    android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageButton android:id="@+id/widget_media_previous" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/widget_media_previous" android:background="@drawable/widget_media_button_background"
                android:padding="12dp" android:contentDescription="@string/widget_media_previous" android:visibility="gone" />
            <ImageButton android:id="@+id/widget_media_toggle" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/widget_media_play" android:background="@drawable/widget_media_button_background"
                android:padding="12dp" android:contentDescription="@string/widget_media_play" android:visibility="gone" />
            <ImageButton android:id="@+id/widget_media_next" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/widget_media_next" android:background="@drawable/widget_media_button_background"
                android:padding="12dp" android:contentDescription="@string/widget_media_next" android:visibility="gone" />
            <TextView android:id="@+id/widget_media_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:minWidth="48dp" android:gravity="center" android:text="@string/widget_media_open" android:textSize="13sp"
                android:textColor="#DDE5F4" android:background="@drawable/widget_media_button_background" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
