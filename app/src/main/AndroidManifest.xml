<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Required by the documented AppWidgetHost contract. A regular app does NOT receive
         this signature permission: bindAppWidgetIdIfAllowed + ACTION_APPWIDGET_BIND ask the
         user for each binding. This narrow lint exception does not grant or bypass access.
         https://developer.android.com/develop/ui/views/appwidgets/host -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/Theme.SidGlassOS"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".DashboardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".features.launcher.LauncherActivity" android:exported="true"
            android:launchMode="singleTask" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".features.widgets.WidgetActionActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <service android:name=".features.wallpapers.ForestWallpaperService" android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER" android:label="Moonlit Forest">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/forest_wallpaper" />
        </service>
        <service android:name=".features.controlcenter.ControlCenterTileService" android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="Glass controls" android:icon="@drawable/ic_glass">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".features.media.MediaAccessService" android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:label="Glass music connection">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
            <!-- API 31+: media sessions need an enabled listener, not notification payloads. -->
            <meta-data android:name="android.service.notification.default_filter_types" android:value="" />
        </service>
        <receiver android:name=".features.widgets.ClockWidgetProvider" android:exported="false" android:label="Glass clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info" />
        </receiver>
        <receiver android:name=".features.widgets.BatteryWidgetProvider" android:exported="false" android:label="Glass battery">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_widget_info" />
        </receiver>
        <receiver android:name=".features.widgets.MusicWidgetProvider" android:exported="false" android:label="Glass music">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/music_widget_info" />
        </receiver>
        <receiver android:name=".features.widgets.InfoWidgetProvider" android:exported="false" android:label="Glass information">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_widget_info" />
        </receiver>
    </application>
</manifest>
